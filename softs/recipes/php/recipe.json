        "libpng-dev",
        "libjpeg-dev",
        "libwebp-dev",
        "libfreetype-dev",
        "libfreetype6-dev",
        "libicu-dev",
        "libsodium-dev",
        "libgmp-dev",
        "libxslt1-dev",
        "libreadline-dev",
        "libbz2-dev",
        "libargon2-dev",
        "libpq-dev",
        "libsystemd-dev",
        "libldap2-dev",
        "libffi-dev",
        "libenchant-2-dev",
        "libtidy-dev",
        "libavif-dev",
        "libedit-dev",
        "libmagickwand-dev",
        "libmemcached-dev",
        "zlib1g-dev"
