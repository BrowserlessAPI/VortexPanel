        "libcurl-devel",
        "libzip-devel",
        "oniguruma-devel",
        "sqlite-devel",
        "libpng-devel",
        "libjpeg-turbo-devel",
        "libwebp-devel",
        "freetype-devel",
        "libicu-devel",
        "libsodium-devel",
        "gmp-devel",
        "libxslt-devel",
        "readline-devel",
        "bzip2-devel",
        "libargon2-devel",
        "libpq-devel",
