{
  "name": "ClamAV",
  "panel_id": "clamav",
  "universal": true,
  "watch": {
    "type": "github-releases",
    "repo": "Cisco-Talos/clamav",
    "regex": "^clamav-(\\d+\\.\\d+\\.\\d+)$",
    "keep_tracks": 2,
    "min_track": "1.4"
  },
  "service": "clamav-daemon",
  "deps": {
    "build": {
      "deb": [],
      "rpm": []
    },
    "run": {
      "deb": [
        "ca-certificates"
      ],
      "rpm": [
        "ca-certificates"
      ]
    },
    "build_el8": [
      "cmake",
      "rust",
      "cargo",
      "openssl-devel",
      "libcurl-devel",
      "json-c-devel",
      "pcre2-devel",
      "bzip2-devel",
      "zlib-devel",
      "libxml2-devel",
      "ncurses-devel",
      "systemd-devel",
      "python3"
    ]
  },
  "replaces": {
    "deb": [
      "clamav",
      "clamav-daemon",
      "clamav-freshclam",
      "clamdscan"
    ],
    "rpm": [
      "clamav",
      "clamd",
      "clamav-update"
    ]
  },
  "smoke": "smoke.sh",
  "comment": "Cisco Talos' Linux release package (one build for every Linux with glibc 2.30 or newer). EL8 has glibc 2.28, so it gets its own build compiled from the same release's source (also_targets).",
  "also_targets": [
    "el8"
  ],
  "rpm_repos": [
    "epel",
    "crb"
  ]
}
